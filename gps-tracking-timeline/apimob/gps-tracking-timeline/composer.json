{
    "name": "yourcompany/gps-tracking-timeline",
    "type": "project",
    "description": "Daily GPS journey / location timeline tracker for field employees.",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.10",
        "guzzlehttp/guzzle": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
